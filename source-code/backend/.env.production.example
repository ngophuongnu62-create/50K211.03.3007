# Mẫu cấu hình PRODUCTION – sao chép thành .env.production (KHÔNG đưa lên Git) hoặc khai báo biến môi trường trên máy chủ.
# Thiếu biến bắt buộc → máy chủ từ chối khởi động và báo rõ biến nào còn thiếu.
NODE_ENV=production
PORT=8080

# Bắt buộc: CSDL MongoDB dạng replica set (cần cho giao dịch), BẬT XÁC THỰC – VD Atlas: mongodb+srv://cluster.xxxx.mongodb.net/BroadwayDB
MONGODB_URI=
# Bắt buộc: tài khoản ỨNG DỤNG (vai trò broadwayApp – không xóa dữ liệu, audit_logs chỉ đọc + thêm). Không dùng tài khoản quản trị.
MONGODB_USER=broadway_app
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin
# 0 = cấu trúc CSDL do bước thiết lập (src/db/thiet-lap-csdl.js, tài khoản quản trị) tạo; ứng dụng không cần quyền đổi cấu trúc
MONGODB_DONG_BO_CAU_TRUC=0
# Bắt buộc: chuỗi ngẫu nhiên ≥ 32 ký tự – tạo bằng: openssl rand -hex 32
JWT_SECRET=
# Bắt buộc: địa chỉ giao diện thật (CORS chỉ chấp nhận các địa chỉ này), nhiều địa chỉ phân tách bằng dấu phẩy
CORS_ORIGIN=https://lichday.broadway.edu.vn

JWT_EXPIRES_NHAN_SU=8h
JWT_EXPIRES_PHU_HUYNH=4h
BCRYPT_ROUNDS=12
UPLOAD_DIR=/data/uploads
RATE_LIMIT_API_PHUT=600
RATE_LIMIT_DANG_NHAP=10
# Số lớp proxy ngược phía trước (Caddy/Nginx/Render = 1)
TRUST_PROXY=1

# Tài khoản Quản lý khởi tạo (chỉ dùng khi hệ thống chưa có Quản lý nào – xem npm run init-master-data)
ADMIN_TEN_DANG_NHAP=admin
ADMIN_HO_TEN=Quản trị hệ thống
ADMIN_EMAIL=
ADMIN_SO_DIEN_THOAI=
# Để trống: hệ thống tự sinh mật khẩu tạm ngẫu nhiên và in ra nhật ký một lần. Luôn bắt buộc đổi ở lần đăng nhập đầu.
ADMIN_MAT_KHAU_TAM=
