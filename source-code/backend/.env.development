# Cấu hình khi LẬP TRÌNH (NODE_ENV=development) – không chứa bí mật thật, được phép đưa lên Git.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/BroadwayDB?replicaSet=rs0
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads
JWT_EXPIRES_NHAN_SU=8h
JWT_EXPIRES_PHU_HUYNH=4h
# Giới hạn tần suất rộng hơn để lập trình thoải mái
RATE_LIMIT_API_PHUT=1000
RATE_LIMIT_DANG_NHAP=50
