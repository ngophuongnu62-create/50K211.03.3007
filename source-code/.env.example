# Cấu hình triển khai PRODUCTION (Docker Compose). Sao chép thành .env rồi sửa. KHÔNG đưa tệp .env lên Git.

# Bắt buộc: chuỗi bí mật ký phiên đăng nhập, tối thiểu 32 ký tự ngẫu nhiên. Tạo nhanh: openssl rand -hex 32
JWT_SECRET=
# Bắt buộc: địa chỉ giao diện người dùng truy cập (CORS chỉ chấp nhận các địa chỉ này; không có dấu / ở cuối)
# Ví dụ một máy chủ phục vụ cả giao diện: https://lichday.broadway.edu.vn  (hoặc http://<IP-máy-chủ>:8080 khi chạy nội bộ)
CORS_ORIGIN=

# MongoDB bật xác thực. Bắt buộc: 2 mật khẩu KHÁC NHAU, mỗi mật khẩu ≥ 16 ký tự. Tạo nhanh: openssl rand -hex 24
# - Tài khoản quản trị: chỉ dùng cho bước thiết lập, sao lưu / khôi phục
MONGO_ROOT_USER=quantri
MONGO_ROOT_PASSWORD=
# - Tài khoản ứng dụng: không được xóa dữ liệu; nhật ký hệ thống (audit_logs) chỉ được đọc và thêm
MONGO_APP_USER=broadway_app
MONGO_APP_PASSWORD=

# Tài khoản Quản lý khởi tạo – chỉ được tạo khi CSDL chưa có Quản lý nào
ADMIN_TEN_DANG_NHAP=admin
ADMIN_HO_TEN=Quản trị hệ thống
ADMIN_EMAIL=
ADMIN_SO_DIEN_THOAI=
# Để trống: hệ thống tự sinh mật khẩu tạm ngẫu nhiên và in MỘT LẦN trong log khởi động (docker compose logs app)
ADMIN_MAT_KHAU_TAM=

# Cổng mở ra ngoài (mặc định 8080)
CONG=8080
# Thời hạn phiên đăng nhập
JWT_EXPIRES_NHAN_SU=8h
JWT_EXPIRES_PHU_HUYNH=4h
# Đặt 1 nếu chạy sau proxy ngược (Nginx, Caddy) để giới hạn tần suất và nhật ký ghi đúng IP người dùng
TRUST_PROXY=0
# Bảo mật: số vòng băm mật khẩu; số yêu cầu API / phút / IP (cả trung tâm dùng chung một IP qua NAT nên để rộng); số lần đăng nhập SAI / 15 phút / IP + tài khoản
BCRYPT_ROUNDS=12
RATE_LIMIT_API_PHUT=600
RATE_LIMIT_DANG_NHAP=10

# HTTPS cho tên miền thật bằng Caddy (xem HUONG_DAN_TRIEN_KHAI.md mục 4). Bỏ dấu # trước 3 dòng dưới khi đã trỏ DNS
# tên miền về máy chủ và mở cổng 80/tcp, 443/tcp, 443/udp. Đặt luôn CORS_ORIGIN=https://<TEN_MIEN> ở trên.
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
# TEN_MIEN=lichday.ten-mien-cua-trung-tam.vn
# EMAIL_ACME=
# Thử trước bằng máy chủ thử nghiệm của Let's Encrypt (bỏ dòng này khi lấy chứng chỉ thật):
# CADDY_TUY_CHON=acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

# Máy chủ ít RAM (VD máy miễn phí 1 GB): giới hạn bộ nhớ đệm MongoDB (GB). Trình cài đặt tự đặt khi RAM < 2 GB.
# MONGO_CACHE_GB=0.25
